# 通用微服务镜像
#
# 用 build arg 指定模块与端口，避免为每个服务复制一份几乎相同的 Dockerfile：
#
#   docker build -f docker/Dockerfile.service \
#     --build-arg MODULE=erp-user-service --build-arg PORT=8084 -t erp-user-service .
#
# MODULE  = Maven 模块目录名（同时是 artifactId 前缀）
# PORT    = 服务监听端口，必须与该模块 src/main/resources/application.yml 的 server.port 一致
#
# 说明：
# - 只构建目标模块及其依赖（-pl ${MODULE} -am），比全 reactor 构建快很多
# - jar 名归一化：有的模块产出 <artifact>-<version>-exec.jar（带 classifier），
#   有的只产出 <artifact>-<version>.jar，统一复制成 /app/app.jar，避免 COPY 通配符歧义
ARG MODULE=erp-order-service
ARG PORT=8081

# 📌 **Maven 镜像源可切换**（2026-11-18 实测修的 CI 红）
#    默认 = aliyun（国内开发者快）；
#    **CI 里显式传 `MAVEN_MIRROR_URL=https://repo1.maven.org/maven2`**
#    → 美区 runner 走官方 Central（实测 aliyun 在美区被限速到 1.0 kB/s → mvn 必超时）。
#    📌 和 npm 那边的修法**同构**（npm 已强制走 registry.npmjs.org），Maven 侧此前一直没修。
ARG MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/central
# 📌 **备用镜像源**（2026-11-19 实测修的 CI 红）
#    ❌ **实测的坑**（CI run 44432877886，2026-11-19）：
#       `Build erp-product-service image` 失败，3 个 POM 全部
#       「Non-resolvable import POM ... (absent)」；
#       但**该 job 全程 `Downloaded` 行数 = 0**（一次都没下成功），
#       而**同一 run 里重叠时间窗的兄弟 job 下载了 980 个文件**。
#       → **不是 artifact 不存在**（本机 curl 同一 URL 返回 200），
#         也**不是网络整体故障** → 是**那一台 runner 的出口被拒**。
#       ⚠️ 原有的「重试 3 次」**重试的是同一个 host** → 被拒就白等 3 次
#          （实测 3 次都在 0.2s 内快速失败，不是超时）→ 必挂。
#    ✅ **修法**：重试时**换源**（不同 CDN 主机，一个不通另一个通）
#       → 被拒的那台 runner 换到 Google 的 Central 镜像即可。
#       📌 备源已实测可用：`maven-central.storage-download.googleapis.com/maven2`（HTTP 200）
#    📌 **换源不用 `sed -i`** —— BSD sed 的 `-i` 要吃扩展名参数（`sed -i "s#..#..#"` 会报
#       「unterminated substitute pattern」），平台差异太大 → 改成 **printf 重写整个文件**。
ARG MAVEN_MIRROR_FALLBACK_URL=https://maven-central.storage-download.googleapis.com/maven2
# 📌 **第三个镜像源**（2026-11-19 第 317 轮实测补的坑）
#    ❌ **原实现的第 3 次 attempt「换回主源」= 无效动作**：
#       Maven 的失败负缓存（`*.lastUpdated`）的 key 里 **URL 也参与比对**
#       → 「换回一个已经试过的 URL」= 又命中那份缓存 → 真正的 pom 不再请求 → 必然秒挂
#       （本地硬判据实测：命中缓存时服务器只收到 **2** 个请求；换 URL 后收到 **18** 个）
#    ✅ **3 次尝试要用 3 个不同的 URL**：主源 → 备源(Google) → 备源2
ARG MAVEN_MIRROR_FALLBACK2_URL=https://repo.maven.apache.org/maven2

FROM maven:3.9-eclipse-temurin-21 AS builder
ARG MODULE
ARG MAVEN_MIRROR_URL
ARG MAVEN_MIRROR_FALLBACK_URL
ARG MAVEN_MIRROR_FALLBACK2_URL
WORKDIR /app

# 📌 **必须同时设成 ENV** —— settings.xml 里用的是 `${env.MAVEN_MIRROR_URL}`
#    （Maven 的**环境属性**插值，只认环境变量，ARG 不算）
ENV MAVEN_MIRROR_URL=${MAVEN_MIRROR_URL}
ENV MAVEN_MIRROR_FALLBACK_URL=${MAVEN_MIRROR_FALLBACK_URL}
ENV MAVEN_MIRROR_FALLBACK2_URL=${MAVEN_MIRROR_FALLBACK2_URL}

# 容器内使用 Maven 镜像（宿主机 ~/.m2/settings.xml 不会自动进容器）
COPY docker/maven-settings.xml /root/.m2/settings.xml

# 复制源码并构建目标模块
COPY . .

# 📌 **超时 + 重试**（2026-11-10 20:45 实测：CI 卡死 50 分钟的根因）
#
#    ⚠️ **这个文件才是真正生效的那份** ——
#       `docker-compose.full.yml`（全部服务）和 CI 的 docker-build 矩阵
#       **都只认 `Dockerfile.service`**；
#       而 `docker/Dockerfile.gateway` 等 **17 个单模块文件是死文件**（无人引用）
#       —— 那份**反而有**重试保护。
#       → **重试保护写在了没人用的文件里，真正生效的这份裸奔**（规则 33 的镜像版）。
#
#    🔴 **症状**：2026-11-10 CI run 42811495288 —— `Build erp-gateway image`
#       从 12:02:23 起 **in_progress 50 分钟**，其余 23 个镜像全部 1-3 分钟完成。
#       → 根因：mvn 拉 aliyun 依赖时**网络挂起**（不是 502 快速失败 → 不会触发重试）
#       → mvn 默认 HTTP 超时很长 → **无限等待** → job 挂到 GitHub 的 6 小时上限
#       → `docker-build` 不完成 → 下游 `deploy-k8s` / `notify` **永远等不到**
#       → **整轮 CI 卡死**（而这不是代码问题，是网络抖动）。
#
#    ✅ 修法（三层）：
#    ① `timeout 600` —— 单次 mvn 最多 10 分钟，**挂起也会被杀**（exit 124）
#    ② 重试 3 次 + 30s 退避 —— 覆盖 502 / 超时等**基础设施抖动**
#    ③ Maven 自身的 wagon 超时/重试参数 —— 让它在**协议层**就快速失败，而不是等 timeout
#    📌 `--mount=type=cache` 的 ~/.m2 缓存**跨重试保留** → 超时被杀后已下载的依赖不浪费
#
#    ⚠️ **最后一次失败仍然让构建失败** —— 不能把失败吞掉（规则 18：事实标志不能撒谎）
#
#    🔴 **2026-11-19 实测修的另一个坑**：「重试 3 次」重试的是**同一个 host** →
#       runner 的出口被拒时，3 次都在 0.2s 内快速失败（不是超时）→ **重试完全无效**。
#       ✅ **改成「换源重试」**：第 1 次用主源，第 2/3 次换成**另一个 CDN 主机**
#          （改写 settings.xml 里的 mirror url）→ 一个不通另一个通。
#       📌 换源后 **Maven 的本地仓库缓存仍复用**（同一个 ~/.m2）→ 已下过的依赖不重下。
RUN --mount=type=cache,target=/root/.m2/repository \
    set -eu; \
    attempt=1; \
    while [ "$attempt" -le 3 ]; do \
      if [ "$attempt" -gt 1 ]; then \
        if [ "$attempt" -eq 2 ]; then \
          MIRROR_TO_USE="${MAVEN_MIRROR_FALLBACK_URL}"; \
        else \
          MIRROR_TO_USE="${MAVEN_MIRROR_FALLBACK2_URL}"; \
        fi; \
        echo "::warning::第 $attempt 次尝试：换源到 ${MIRROR_TO_USE}"; \
        printf '%s\n' \
          '<settings>' \
          '  <mirrors>' \
          '    <mirror>' \
          '      <id>ci-central</id>' \
          "      <url>${MIRROR_TO_USE}</url>" \
          '      <mirrorOf>central</mirrorOf>' \
          '    </mirror>' \
          '  </mirrors>' \
          '</settings>' > /root/.m2/settings.xml; \
        # 🔴 **必须清掉失败负缓存**（2026-11-19 第 317 轮本地实测）：
        #    Maven 把「某个 (仓库id,url) 下没找到」记进 `*.lastUpdated` →
        #    **同一个 id + 同一个 url 再来一次 = 直接复用失败结论、真正的 pom 不再请求**
        #    （实测：命中缓存时服务器只收到 2 个 metadata 探测；换 URL / 加 -U / 清掉它 → 收到 18 个）
        #    → gha 的 maven cache 会把 `.lastUpdated` **一起带进下一次构建** → 不清就是「继承上一轮的失败」。
        find /root/.m2/repository -name "*.lastUpdated" -delete 2>/dev/null || true; \
        sleep 15; \
      fi; \
      if timeout 600 mvn -B -U clean package -DskipTests \
           -Dmaven.wagon.http.retryHandler.count=3 \
           -Dmaven.wagon.httpconnectionManager.ttlSeconds=60 \
           -Dmaven.wagon.http.pool=false \
           -pl "${MODULE}" -am; then break; fi; \
      echo "::warning::Maven 构建第 $attempt 次失败/超时（单次上限 600s），30s 后重试"; \
      attempt=$((attempt + 1)); \
      sleep 30; \
    done; \
    if [ "$attempt" -gt 3 ]; then \
      echo "::error::Maven 构建重试 3 次仍失败"; \
      exit 1; \
    fi; \
    JAR="$(ls /app/${MODULE}/target/${MODULE}-*-exec.jar 2>/dev/null | head -1 || true)"; \
    if [ -z "$JAR" ]; then \
      JAR="$(ls /app/${MODULE}/target/${MODULE}-*.jar | head -1)"; \
    fi; \
    cp "$JAR" /app/app.jar

FROM eclipse-temurin:21-jre-alpine
ARG MODULE
ARG PORT
WORKDIR /app

# 安装时区数据
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apk del tzdata

COPY --from=builder /app/app.jar ./app.jar

ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
