# 通用微服务镜像
#
# 用 build arg 指定模块与端口，避免为每个服务复制一份几乎相同的 Dockerfile：
#
#   docker build -f docker/Dockerfile.service \
#     --build-arg MODULE=erp-user-service --build-arg PORT=8084 -t erp-user-service .
#
# MODULE  = Maven 模块目录名（同时是 artifactId 前缀）
# PORT    = 服务监听端口，必须与该模块 src/main/resources/application.yml 的 server.port 一致
#
# 说明：
# - 只构建目标模块及其依赖（-pl ${MODULE} -am），比全 reactor 构建快很多
# - jar 名归一化：有的模块产出 <artifact>-<version>-exec.jar（带 classifier），
#   有的只产出 <artifact>-<version>.jar，统一复制成 /app/app.jar，避免 COPY 通配符歧义
ARG MODULE=erp-order-service
ARG PORT=8081

FROM maven:3.9-eclipse-temurin-21 AS builder
ARG MODULE
WORKDIR /app

# 容器内使用 aliyun 镜像（宿主机 ~/.m2/settings.xml 不会自动进容器）
COPY docker/maven-settings.xml /root/.m2/settings.xml

# 复制源码并构建目标模块
COPY . .

# 📌 **超时 + 重试**（2026-11-10 20:45 实测：CI 卡死 50 分钟的根因）
#
#    ⚠️ **这个文件才是真正生效的那份** ——
#       `docker-compose.full.yml`（全部服务）和 CI 的 docker-build 矩阵
#       **都只认 `Dockerfile.service`**；
#       而 `docker/Dockerfile.gateway` 等 **17 个单模块文件是死文件**（无人引用）
#       —— 那份**反而有**重试保护。
#       → **重试保护写在了没人用的文件里，真正生效的这份裸奔**（规则 33 的镜像版）。
#
#    🔴 **症状**：2026-11-10 CI run 42811495288 —— `Build erp-gateway image`
#       从 12:02:23 起 **in_progress 50 分钟**，其余 23 个镜像全部 1-3 分钟完成。
#       → 根因：mvn 拉 aliyun 依赖时**网络挂起**（不是 502 快速失败 → 不会触发重试）
#       → mvn 默认 HTTP 超时很长 → **无限等待** → job 挂到 GitHub 的 6 小时上限
#       → `docker-build` 不完成 → 下游 `deploy-k8s` / `notify` **永远等不到**
#       → **整轮 CI 卡死**（而这不是代码问题，是网络抖动）。
#
#    ✅ 修法（三层）：
#    ① `timeout 600` —— 单次 mvn 最多 10 分钟，**挂起也会被杀**（exit 124）
#    ② 重试 3 次 + 30s 退避 —— 覆盖 502 / 超时等**基础设施抖动**
#    ③ Maven 自身的 wagon 超时/重试参数 —— 让它在**协议层**就快速失败，而不是等 timeout
#    📌 `--mount=type=cache` 的 ~/.m2 缓存**跨重试保留** → 超时被杀后已下载的依赖不浪费
#
#    ⚠️ **最后一次失败仍然让构建失败** —— 不能把失败吞掉（规则 18：事实标志不能撒谎）
RUN --mount=type=cache,target=/root/.m2/repository \
    set -eu; \
    attempt=1; \
    while [ "$attempt" -le 3 ]; do \
      if timeout 600 mvn -B clean package -DskipTests \
           -Dmaven.wagon.http.retryHandler.count=3 \
           -Dmaven.wagon.httpconnectionManager.ttlSeconds=60 \
           -Dmaven.wagon.http.pool=false \
           -pl "${MODULE}" -am; then break; fi; \
      echo "::warning::Maven 构建第 $attempt 次失败/超时（单次上限 600s），30s 后重试"; \
      attempt=$((attempt + 1)); \
      sleep 30; \
    done; \
    if [ "$attempt" -gt 3 ]; then \
      echo "::error::Maven 构建重试 3 次仍失败"; \
      exit 1; \
    fi; \
    JAR="$(ls /app/${MODULE}/target/${MODULE}-*-exec.jar 2>/dev/null | head -1 || true)"; \
    if [ -z "$JAR" ]; then \
      JAR="$(ls /app/${MODULE}/target/${MODULE}-*.jar | head -1)"; \
    fi; \
    cp "$JAR" /app/app.jar

FROM eclipse-temurin:21-jre-alpine
ARG MODULE
ARG PORT
WORKDIR /app

# 安装时区数据
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    apk del tzdata

COPY --from=builder /app/app.jar ./app.jar

ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
