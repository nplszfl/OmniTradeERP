<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.crossborder</groupId>
    <artifactId>cross-border-erp</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>OmniTradeERP</name>
    <description>跨境电商ERP系统 - 微服务架构</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Cloud 2024.x 最新版本 -->
        <spring-boot.version>3.1.5</spring-boot.version>
        <spring-cloud.version>2022.0.4</spring-cloud.version>
        <spring-cloud-alibaba.version>2022.0.0.0</spring-cloud-alibaba.version>

        <!--
          内部模块的版本号。
          ⚠️ 内部模块（erp-common / erp-platform-api / erp-order-service）必须用固定版本，
          不能用 ${project.version} —— ${project.version} 解析的是「当前使用方的版本」，
          而本项目里有 4 个模块自带了各自的版本号：
            erp-pricing-service              2.0.0
            erp-inventory-prediction-service 1.5.0
            erp-anomaly-detection-service    1.6.0
            erp-product-recommendation-service 1.9.0
          它们一旦依赖内部模块，就会去仓库找 erp-common:2.0.0 这种根本不存在的版本 → 构建失败。
        -->
        <erp.internal.version>1.0.0-SNAPSHOT</erp.internal.version>

        <!-- 其他依赖 -->
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <hutool.version>5.8.26</hutool.version>
        <fastjson2.version>2.0.49</fastjson2.version>
        <okhttp.version>4.12.0</okhttp.version>
        <jwt.version>0.12.3</jwt.version>
    </properties>

    <modules>
        <module>erp-common</module>
        <module>erp-gateway</module>
        <module>erp-tenant-service</module>
        <module>erp-customer-service</module>
        <module>erp-supplier-service</module>
        <module>erp-inventory-alert-service</module>
        <module>erp-order-service</module>
        <module>erp-platform-api</module>
        <module>erp-platform-service</module>
        <module>erp-product-service</module>
        <module>erp-user-service</module>
        <module>erp-pricing-service</module>
        <module>erp-inventory-prediction-service</module>
        <module>erp-social-commerce-service</module>
        <module>erp-reporting-service</module>
        <module>erp-purchase-service</module>
        <module>erp-anomaly-detection-service</module>
        <module>erp-product-recommendation-service</module>
        <module>erp-analytics-service</module>
        <module>erp-ai-assistant-service</module>
        <module>erp-product-description-service</module>
        <!--
          erp-assembly：**单体聚合模块**，故意不启用。

          📌 现状：模块里 **0 个 java 文件**，pom 里配的
             <mainClass>com.crossborder.erp.ErpApplication</mainClass>
             **这个类不存在**。
          📌 **注意**：显式配 <mainClass> 时 spring-boot-maven-plugin **不会校验**
             类是否存在 → `mvn package` **照样 BUILD SUCCESS**，
             产出 99MB 的 fat jar，**真跑起来才炸**
             （ClassNotFoundException: com.crossborder.erp.ErpApplication）。
          📌 不用它的原因：当前部署形态是**微服务 + 网关**（compose/k8s 里
             21 个独立服务），没有任何编排引用这个聚合 jar。
             要启用它 = 要同时写一个跨全部服务的单体启动类，
             而各服务各有自己的 @SpringBootApplication 和独立数据源，
             组件扫描会直接冲突 —— 这是一次架构改造，不是补个类的事。
          📌 巡检 `scripts/check-boot-main-class.py` 会把它列为
             「未启用模块」并说明状态（不计入失败，因为它不会被部署）。
        -->
        <!-- <module>erp-assembly</module> -->
        <module>erp-finance-service</module>
        <module>erp-inventory-service</module>
        <module>erp-warehouse-service</module>
        <module>erp-logistics-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Nacos -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>

            <!-- Sentinel -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>

            <!-- OpenFeign -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-openfeign</artifactId>
                <version>3.1.5</version>
            </dependency>

            <!-- Gateway -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-gateway</artifactId>
                <version>4.1.1</version>
            </dependency>

            <!-- LoadBalancer -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-starter-loadbalancer</artifactId>
                <version>4.1.1</version>
            </dependency>

            <!-- MyBatis Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- FastJSON2 -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

            <!-- OkHttp -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- Micrometer Prometheus -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>1.12.2</version>
            </dependency>

            <!-- Micrometer Core -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>1.12.2</version>
            </dependency>

            <!-- SpringDoc OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>2.3.0</version>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.crossborder</groupId>
                <artifactId>erp-common</artifactId>
                <version>${erp.internal.version}</version>
            </dependency>
            <dependency>
                <groupId>com.crossborder</groupId>
                <artifactId>erp-platform-api</artifactId>
                <version>${erp.internal.version}</version>
            </dependency>
            <dependency>
                <groupId>com.crossborder</groupId>
                <artifactId>erp-order-service</artifactId>
                <version>${erp.internal.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Test (includes Mockito) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
